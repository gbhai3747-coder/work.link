# ---- Supabase ----
# Find these in your Supabase project dashboard: Settings -> API
# Bare project URL (no path). Do NOT append /rest/v1 or any other suffix —
# supabase-js adds /auth/v1, /rest/v1, /storage/v1 etc. itself, so a path here
# breaks every request (e.g. signup returns "Invalid path specified in request URL").
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (SERVER ONLY - never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Maps / Geocoding provider (SERVER ONLY - never in the browser) ----
# Provider is swappable. Supported: "mapbox" | "google" | "nominatim" | "none"
# "none" keeps browser geolocation + nearby-worker search working; only
# free-text address geocoding is disabled.
#
# "nominatim" (recommended, free, no API key or billing):
#   OpenStreetMap's free reverse/forward geocoding. The app serialises requests
#   to ~1/sec and sends a User-Agent, per Nominatim's usage policy:
#   https://operations.osmfoundation.org/policies/nominatim/
#   Results are cached in-memory on the server for 24h.
#
# "google":
#   Better address quality, but requires a Google Cloud project with billing:
#     1. Enable the "Geocoding API" in Google Cloud Console.
#     2. Create an API key (APIs & Services -> Credentials -> API key).
#     3. Restrict the key to the Geocoding API and paste it into
#        MAPS_ACCESS_TOKEN below. Keep it server-side only.
#
# "mapbox":
#   Mapbox Geocoding API; put your Mapbox access token in MAPS_ACCESS_TOKEN.
MAPS_PROVIDER=nominatim
MAPS_ACCESS_TOKEN=

# ---- Supabase auth ----
# If you disable email confirmation in Supabase Auth, leave these unset.
# Otherwise, whitelist this URL in Auth settings and uncomment:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
